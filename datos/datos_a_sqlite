"""
============================================================================
SCRIPT: CARGAR DATOS DEL DATAFRAME FINAL A SQLITE
============================================================================
Este script carga los datos limpios del proceso ETL a una base de datos SQLite
y permite ejecutar consultas SQL sobre los datos.

Requisitos:
- Archivo CSV: datos/datos_limpios.csv (generado por el notebook)
- Esquema SQL: sql/schema.sql (define la estructura de la tabla)
- Consultas SQL: sql/consultas.sql (consultas de análisis)

Autores: Grupo ABP Innovación 2025
============================================================================
"""

import pandas as pd
import sqlite3
import os
from datetime import datetime

def crear_base_datos():
    """
    Crea la base de datos SQLite y la estructura de tablas
    """
    print('=' * 80)
    print('PASO 1: CREAR BASE DE DATOS Y ESQUEMA')
    print('=' * 80)
    
    # Ruta de la base de datos
    db_path = 'sql/ventas.db'
    
    # Eliminar base de datos anterior si existe
    if os.path.exists(db_path):
        os.remove(db_path)
        print(f'✅ Base de datos anterior eliminada: {db_path}')
    
    # Crear conexión a SQLite (crea el archivo automáticamente)
    conn = sqlite3.connect(db_path)
    cursor = conn.cursor()
    
    # Leer el esquema SQL
    schema_path = 'sql/schema.sql'
    if not os.path.exists(schema_path):
        print(f'❌ ERROR: No se encontró el archivo {schema_path}')
        return None
    
    with open(schema_path, 'r', encoding='utf-8') as f:
        schema_sql = f.read()
    
    # Ejecutar el esquema SQL (crear tablas e índices)
    try:
        # SQLite no soporta múltiples statements de una vez, hay que separarlos
        statements = schema_sql.split(';')
        for statement in statements:
            statement = statement.strip()
            if statement and not statement.startswith('--'):
                cursor.execute(statement)
        
        conn.commit()
        print(f'✅ Esquema de base de datos creado exitosamente')
        print(f'✅ Archivo: {db_path}')
        
    except sqlite3.Error as e:
        print(f'❌ ERROR al crear esquema: {e}')
        conn.close()
        return None
    
    return conn


def cargar_datos_desde_csv(conn):
    """
    Carga los datos desde el CSV limpio al DataFrame y luego a SQLite
    """
    print('\n' + '=' * 80)
    print('PASO 2: CARGAR DATOS DESDE CSV')
    print('=' * 80)
    
    # Ruta del CSV limpio
    csv_path = 'datos/datos_limpios.csv'
    
    if not os.path.exists(csv_path):
        print(f'❌ ERROR: No se encontró el archivo {csv_path}')
        print('   Por favor, ejecuta el notebook primero para generar datos_limpios.csv')
        return False
    
    # Leer CSV con Pandas
    try:
        df_final = pd.read_csv(csv_path)
        print(f'✅ CSV cargado exitosamente')
        print(f'   Registros: {len(df_final):,}')
        print(f'   Columnas: {len(df_final.columns)}')
        
    except Exception as e:
        print(f'❌ ERROR al leer CSV: {e}')
        return False
    
    # Convertir columna de fecha a formato correcto
    df_final['invoice_date'] = pd.to_datetime(df_final['invoice_date'])
    
    # Mostrar primeras filas
    print('\n📊 Primeras 3 filas del DataFrame:')
    print(df_final.head(3))
    
    return df_final


def insertar_datos_en_sqlite(conn, df_final):
    """
    Inserta los datos del DataFrame en la tabla SQLite
    """
    print('\n' + '=' * 80)
    print('PASO 3: INSERTAR DATOS EN SQLITE')
    print('=' * 80)
    
    try:
        # Usar to_sql de Pandas para insertar datos
        # if_exists='append' porque ya creamos la tabla con el schema.sql
        df_final.to_sql(
            name='datos_limpios',
            con=conn,
            if_exists='replace',  # Reemplazar porque ya existe la estructura
            index=False,
            chunksize=1000  # Insertar en lotes de 1000 para eficiencia
        )
        
        print(f'✅ Datos insertados exitosamente')
        
        # Verificar cantidad de registros
        cursor = conn.cursor()
        cursor.execute("SELECT COUNT(*) FROM datos_limpios")
        count = cursor.fetchone()[0]
        print(f'✅ Total de registros en base de datos: {count:,}')
        
        # Verificar índices
        cursor.execute("SELECT name FROM sqlite_master WHERE type='index'")
        indices = cursor.fetchall()
        print(f'\n📊 Índices creados: {len(indices)}')
        for idx in indices:
            print(f'   - {idx[0]}')
        
        return True
        
    except Exception as e:
        print(f'❌ ERROR al insertar datos: {e}')
        return False


def ejecutar_consulta(conn, consulta_sql, titulo):
    """
    Ejecuta una consulta SQL y muestra los resultados
    """
    print('\n' + '=' * 80)
    print(titulo)
    print('=' * 80)
    
    try:
        # Usar Pandas para ejecutar consulta y mostrar como DataFrame
        df_resultado = pd.read_sql_query(consulta_sql, conn)
        print(df_resultado.to_string(index=False))
        print(f'\n✅ Consulta ejecutada exitosamente ({len(df_resultado)} filas)')
        return df_resultado
        
    except Exception as e:
        print(f'❌ ERROR al ejecutar consulta: {e}')
        return None


def ejecutar_consultas_principales(conn):
    """
    Ejecuta las consultas SQL principales del proyecto
    """
    print('\n' + '=' * 80)
    print('PASO 4: EJECUTAR CONSULTAS SQL')
    print('=' * 80)
    
    # CONSULTA 1: Modo de pago más frecuente
    consulta1 = """
    SELECT 
        payment_method AS 'Método de Pago',
        COUNT(*) AS 'Cantidad de Transacciones',
        ROUND(COUNT(*) * 100.0 / (SELECT COUNT(*) FROM datos_limpios), 2) AS 'Porcentaje (%)'
    FROM datos_limpios
    GROUP BY payment_method
    ORDER BY COUNT(*) DESC;
    """
    ejecutar_consulta(conn, consulta1, "CONSULTA 1: Modo de pago más frecuente de todos los clientes")
    
    # CONSULTA 2: Modo de pago por género
    consulta2 = """
    SELECT 
        gender AS 'Género',
        payment_method AS 'Método de Pago',
        COUNT(*) AS 'Cantidad',
        ROUND(AVG(total_sale), 2) AS 'Ticket Promedio ($)'
    FROM datos_limpios
    GROUP BY gender, payment_method
    ORDER BY gender, COUNT(*) DESC;
    """
    ejecutar_consulta(conn, consulta2, "CONSULTA 2: Modo de pago categorizado por género")
    
    # CONSULTA 3: Métodos de pago en rango 25-35 años
    consulta3 = """
    SELECT 
        payment_method AS 'Método de Pago',
        COUNT(*) AS 'Cantidad',
        ROUND(COUNT(*) * 100.0 / (SELECT COUNT(*) FROM datos_limpios WHERE age BETWEEN 25 AND 35), 2) AS 'Porcentaje (%)'
    FROM datos_limpios
    WHERE age BETWEEN 25 AND 35
    GROUP BY payment_method
    ORDER BY COUNT(*) DESC;
    """
    ejecutar_consulta(conn, consulta3, "CONSULTA 3: Métodos de pago en rango etario 25-35 años")
    
    # CONSULTA 4: Métodos de pago más utilizados por mujeres
    consulta4 = """
    SELECT 
        payment_method AS 'Método de Pago',
        COUNT(*) AS 'Cantidad',
        ROUND(COUNT(*) * 100.0 / (SELECT COUNT(*) FROM datos_limpios WHERE gender = 'Female'), 2) AS 'Porcentaje (%)'
    FROM datos_limpios
    WHERE gender = 'Female'
    GROUP BY payment_method
    ORDER BY COUNT(*) DESC;
    """
    ejecutar_consulta(conn, consulta4, "CONSULTA 4: Métodos de pago más utilizados por mujeres")
    
    # CONSULTA 5: Precios por categoría de productos
    consulta5 = """
    SELECT 
        category AS 'Categoría',
        ROUND(MIN(price), 2) AS 'Precio Mínimo ($)',
        ROUND(MAX(price), 2) AS 'Precio Máximo ($)',
        ROUND(AVG(price), 2) AS 'Precio Promedio ($)',
        ROUND(SUM(total_sale), 2) AS 'Ventas Totales ($)',
        COUNT(*) AS 'Transacciones'
    FROM datos_limpios
    GROUP BY category
    ORDER BY SUM(total_sale) DESC;
    """
    ejecutar_consulta(conn, consulta5, "CONSULTA 5: Precios por categoría de productos")
    
    # CONSULTA EXTRA: Top 5 shopping malls
    consulta_extra = """
    SELECT 
        shopping_mall AS 'Shopping Mall',
        COUNT(*) AS 'Transacciones',
        ROUND(SUM(total_sale), 2) AS 'Ventas Totales ($)',
        ROUND(AVG(total_sale), 2) AS 'Ticket Promedio ($)'
    FROM datos_limpios
    GROUP BY shopping_mall
    ORDER BY SUM(total_sale) DESC
    LIMIT 5;
    """
    ejecutar_consulta(conn, consulta_extra, "CONSULTA EXTRA: Top 5 Shopping Malls por ventas")


def consulta_personalizada(conn):
    """
    Permite al usuario ejecutar consultas SQL personalizadas
    """
    print('\n' + '=' * 80)
    print('CONSULTAS PERSONALIZADAS')
    print('=' * 80)
    print('Escribe tu consulta SQL (escribe "salir" para terminar)')
    print('Ejemplo: SELECT * FROM datos_limpios LIMIT 5;')
    print('-' * 80)
    
    while True:
        consulta = input('\nSQL> ').strip()
        
        if consulta.lower() == 'salir':
            break
        
        if not consulta:
            continue
        
        try:
            df_resultado = pd.read_sql_query(consulta, conn)
            print('\n' + df_resultado.to_string(index=False))
            print(f'\n✅ {len(df_resultado)} filas devueltas')
        except Exception as e:
            print(f'❌ ERROR: {e}')


def main():
    """
    Función principal que ejecuta todo el proceso
    """
    print('\n')
    print('╔' + '=' * 78 + '╗')
    print('║' + ' ' * 20 + 'CARGA DE DATOS ETL A SQLITE' + ' ' * 31 + '║')
    print('║' + ' ' * 20 + 'Proyecto ABP Innovación 2025' + ' ' * 31 + '║')
    print('╚' + '=' * 78 + '╝')
    print()
    
    # Paso 1: Crear base de datos y esquema
    conn = crear_base_datos()
    if conn is None:
        print('\n❌ ERROR: No se pudo crear la base de datos')
        return
    
    # Paso 2: Cargar datos desde CSV
    df_final = cargar_datos_desde_csv(conn)
    if df_final is False:
        conn.close()
        return
    
    # Paso 3: Insertar datos en SQLite
    if not insertar_datos_en_sqlite(conn, df_final):
        conn.close()
        return
    
    # Paso 4: Ejecutar consultas principales
    ejecutar_consultas_principales(conn)
    
    # Información final
    print('\n' + '=' * 80)
    print('✅ PROCESO COMPLETADO EXITOSAMENTE')
    print('=' * 80)
    print(f'📁 Base de datos creada: sql/ventas.db')
    print(f'📊 Registros cargados: {len(df_final):,}')
    print(f'🔍 Puedes abrir la base de datos con DB Browser for SQLite')
    print(f'📝 Consultas SQL disponibles en: sql/consultas.sql')
    
    # Tamaño del archivo
    db_size = os.path.getsize('sql/ventas.db') / (1024 * 1024)
    print(f'💾 Tamaño de la base de datos: {db_size:.2f} MB')
    
    # Preguntar si quiere ejecutar consultas personalizadas
    print('\n' + '=' * 80)
    respuesta = input('¿Deseas ejecutar consultas personalizadas? (s/n): ').strip().lower()
    if respuesta == 's':
        consulta_personalizada(conn)
    
    # Cerrar conexión
    conn.close()
    print('\n✅ Conexión a base de datos cerrada')
    print('=' * 80)


if __name__ == '__main__':
    main()
